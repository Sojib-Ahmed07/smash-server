<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Welcome to SMASH' %></title>
    <!-- Tailwind CSS Play CDN for beautiful styling -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        /* Smooth transitions for interactive components */
        .transition-all { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
    </style>
</head>
<body class="bg-[#09090b] text-[#fafafa] font-sans antialiased min-h-screen flex flex-col justify-between overflow-x-hidden">

    <!-- Aesthetic Ambient Background Gradients -->
    <div class="absolute top-0 left-1/2 -z-10 h-[600px] w-[1000px] -translate-x-1/2 bg-[radial-gradient(circle_at_center,rgba(120,119,198,0.1),transparent_50%)] pointer-events-none"></div>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col items-center justify-center px-4 py-16 text-center relative">
        <div class="max-w-xl space-y-6">
            
            <!-- Welcome Decorative Icon Badge -->
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 text-white shadow-xl shadow-purple-500/20 animate-pulse mx-auto">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-7 h-7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.467 5.99 5.99 0 0 0-1.925 3.546 5.974 5.974 0 0 1-2.133-1A3.75 3.75 0 0 0 12 18Z" />
                </svg>
            </div>

            <!-- Dynamic Heading Setup -->
            <div class="space-y-3">
                <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl bg-gradient-to-r from-white via-neutral-200 to-neutral-400 bg-clip-text text-transparent">
                    Welcome to SMASH
                </h1>
                
                <!-- Safe Fallback using EJS conditional logic -->
                <p class="text-lg text-neutral-400 max-w-md mx-auto">
                    <% if (typeof user !== 'undefined' && user.name) { %>
                        Hi, <span class="text-purple-400 font-semibold"><%= user.name %></span>! Great to see you back.
                    <% } else { %>
                        Hi there! Ready to jump into the ultimate battle?
                    <% } %>
                </p>
            </div>

            <!-- Sleek Glassmorphic Information Card -->
            <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 backdrop-blur-md text-left space-y-4 shadow-2xl">
                <h3 class="text-sm font-semibold text-neutral-200 uppercase tracking-wider">Quick Actions</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <a href="/battles" class="flex items-center justify-between p-3 rounded-xl bg-neutral-800/30 border border-neutral-800 hover:bg-neutral-800/60 transition-all group">
                        <span class="text-sm font-medium text-neutral-300">View Active Battles</span>
                        <span class="text-neutral-500 group-hover:text-purple-400 transition-all">&rarr;</span>
                    </a>
                    <a href="/leaderboard" class="flex items-center justify-between p-3 rounded-xl bg-neutral-800/30 border border-neutral-800 hover:bg-neutral-800/60 transition-all group">
                        <span class="text-sm font-medium text-neutral-300">Leaderboard</span>
                        <span class="text-neutral-500 group-hover:text-pink-400 transition-all">&rarr;</span>
                    </a>
                </div>
            </div>

            <!-- Call to Action Button Row -->
            <div class="pt-4 flex flex-col sm:flex-row justify-center gap-3">
                <a href="/dashboard" class="inline-flex h-11 items-center justify-center rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 px-6 text-sm font-medium text-white shadow-lg shadow-indigo-500/10 hover:opacity-90 transition-all">
                    Go to Dashboard
                </a>
                <a href="/" class="inline-flex h-11 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900/50 px-6 text-sm font-medium text-neutral-300 hover:bg-neutral-800/50 transition-all">
                    Return Home
                </a>
            </div>

        </div>
    </main>

    <!-- Clean Footer -->
    <footer class="w-full border-t border-neutral-900 py-6 text-center text-xs text-neutral-500">
        <p>&copy; <%= new Date().getFullYear() %> SMASH. All rights reserved.</p>
    </footer>

</body>
</html>