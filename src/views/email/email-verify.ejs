<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Email</title>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        background-color: #f9fafb;
        margin: 0;
        padding: 0;
        -webkit-font-smoothing: antialiased;
      }
      .wrapper {
        width: 100%;
        table-layout: fixed;
        background-color: #f9fafb;
        padding-bottom: 40px;
        padding-top: 40px;
      }
      .container {
        max-width: 600px;
        background-color: #ffffff;
        margin: 0 auto;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
      }
      .header {
        background-color: #1e1b4b; /* Deep Indigo matching your Smash Arena branding */
        padding: 32px;
        text-align: center;
      }
      .header h1 {
        color: #ffffff;
        font-size: 24px;
        margin: 0;
        font-weight: 700;
        letter-spacing: -0.05em;
      }
      .content {
        padding: 40px 32px;
      }
      .content h2 {
        color: #111827;
        font-size: 20px;
        margin-top: 0;
        margin-bottom: 16px;
      }
      .content p {
        color: #4b5563;
        font-size: 16px;
        line-height: 1.6;
        margin-top: 0;
        margin-bottom: 24px;
      }
      .btn-container {
        text-align: center;
        margin-bottom: 32px;
        margin-top: 32px;
      }
      .btn {
        background-color: #4f46e5; /* Vibrant indigo */
        color: #ffffff !important;
        text-decoration: none;
        padding: 14px 32px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 6px;
        display: inline-block;
        box-shadow: 0 2px 4px rgba(79, 70, 229, 0.2);
      }
      .footer {
        background-color: #f3f4f6;
        padding: 24px 32px;
        text-align: center;
        border-top: 1px solid #e5e7eb;
      }
      .footer p {
        color: #9ca3af;
        font-size: 13px;
        margin: 0;
        line-height: 1.5;
      }
      .fallback-link {
        color: #4f46e5;
        word-break: break-all;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <div class="header">
          <h1>SMASH</h1>
        </div>

        <div class="content">
          <h2>Hello <%= user.name %>,</h2>
          <p>
            Thank you for signing up! To complete your registration and secure
            your account, please verify your email address by clicking the
            action button below:
          </p>

          <div class="btn-container">
            <a href="<%= actionUrl %>" class="btn" target="_blank"
              >Verify Email Address</a
            >
          </div>

          <p>
            This verification link will expire in 24 hours. If you did not
            create an account with us, you can safely ignore this email.
          </p>

          <hr
            style="border: 0; border-top: 1px solid #e5e7eb; margin: 32px 0"
          />

          <p style="font-size: 14px; color: #6b7280">
            If you’re having trouble clicking the button, copy and paste the URL
            below into your web browser:
            <br />
            <a href="<%= actionUrl %>" class="fallback-link"
              ><%= actionUrl %></a
            >
          </p>
        </div>

        <div class="footer">
          <p>
            &copy; <%= new Date().getFullYear() %> Smash. All rights
            reserved.
          </p>
          <p style="margin-top: 4px">Dhaka, Bangladesh</p>
        </div>
      </div>
    </div>
  </body>
</html>
